{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "images:optimize": "node tools/optimize-images.js --all",
    "images:staged": "node tools/optimize-images.js --staged",
    "math:check": "node tools/check-math.js",
    "math:fix": "node tools/check-math.js --fix",
    "spacing": "node tools/format-spacing.mjs --all",
    "spacing:check": "node tools/format-spacing.mjs --check",
    "spacing:staged": "node tools/format-spacing.mjs --staged",
    "test:spacing": "node --test tools/format-spacing.test.mjs",
    "prepare": "simple-git-hooks",
    "server": "hexo server",
    "verify": "node tools/verify-build.js"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "packageManager": "npm@11.17.0",
  "simple-git-hooks": {
    "pre-commit": "npm run images:staged && npm run spacing:staged"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "@renbaoshuo/markdown-it-katex": "^2.0.2",
    "hexo": "8.1.2",
    "hexo-abbrlink": "2.2.1",
    "hexo-excerpt": "1.3.1",
    "hexo-filter-github-emojis": "3.0.5",
    "hexo-filter-nofollow": "2.0.2",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-feed": "4.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-search": "2.4.3",
    "hexo-generator-sitemap": "3.0.1",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-markdown-it": "^7.1.1",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0",
    "hexo-symbols-count-time": "0.7.1",
    "hexo-theme-next": "8.28.0",
    "katex": "0.18.1"
  },
  "devDependencies": {
    "mdast-util-from-markdown": "2.0.3",
    "pangu": "8.0.0",
    "sharp": "0.35.3",
    "simple-git-hooks": "2.13.1"
  }
}
